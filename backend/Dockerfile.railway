# Railway (512 MB, no PyTorch). Same image as deploy/render/Dockerfile; Railway root directory = backend/.
# Stage 1 builds the embedding model (int8 token table, float32 transformer); see scripts/quantize_onnx.py.
FROM python:3.12-slim AS model
ENV HF_HOME=/hf PIP_NO_CACHE_DIR=1
RUN pip install onnx==1.17.0 onnxruntime==1.20.1 huggingface_hub==1.21.0 sentencepiece==0.2.2 numpy==2.4.2
COPY scripts/quantize_onnx.py /quantize.py
RUN mkdir /model && python /quantize.py /model/model_emb8.onnx

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONIOENCODING=utf-8 HF_HOME=/app/.hf PIP_NO_CACHE_DIR=1 HF_HUB_OFFLINE=1 \
    PATHSYNC_EMBED_BACKEND=onnx PATHSYNC_ONNX_FILE=/app/model/model_emb8.onnx PATHSYNC_WORKERS=1 MALLOC_ARENA_MAX=2
COPY requirements-slim.txt .
RUN pip install -r requirements-slim.txt
COPY --from=model /model /app/model
COPY . .
RUN useradd --create-home --uid 10001 pathsync && chown -R pathsync:pathsync /app
USER pathsync
CMD ["sh", "docker-entrypoint.sh"]

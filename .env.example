# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
PATHSYNC_DOMAIN=pathsync.example.id
POSTGRES_PASSWORD=
# Admin token: 32+ random characters, stored only here / in your secret manager. Rotate after every event.
PATHSYNC_ADMIN_TOKEN=
# Optional
# 2 workers measured best on a 12-CPU host (4 was not faster and each worker loads its own embedding model).
# Each worker opens up to PATHSYNC_DB_POOL + PATHSYNC_DB_OVERFLOW (15 + 15) PostgreSQL connections; keep
# workers x 30 + 10 under max_connections (100 by default).
PATHSYNC_WORKERS=2
SENTRY_DSN=
ANTHROPIC_API_KEY=
BACKUP_KEEP_DAYS=14

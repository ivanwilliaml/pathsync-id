# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
PATHSYNC_DOMAIN=pathsync.example.id
POSTGRES_PASSWORD=
# Admin token: 32+ random characters, stored only here / in your secret manager. Rotate after every event.
PATHSYNC_ADMIN_TOKEN=
# Optional
PATHSYNC_WORKERS=2
SENTRY_DSN=
ANTHROPIC_API_KEY=
BACKUP_KEEP_DAYS=14
